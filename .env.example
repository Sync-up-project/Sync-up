# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncup
DATABASE_URL=postgresql://postgres:postgres@db:5432/syncup

# Backend Configuration
NODE_ENV=development
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=syncup

# Frontend Configuration (주소 결정 로직: frontend/src/lib/backendUrl.ts)
# 브라우저가 호출할 백엔드 주소. 개발(docker compose)용 값입니다.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Next 서버(API 라우트)가 컨테이너 네트워크 안에서 호출할 백엔드 주소. 런타임에 읽힙니다.
INTERNAL_BACKEND_URL=http://backend:3000
# 운영 이미지 빌드 시 브라우저 번들에 넣을 백엔드 주소. 비우면 "/backend" (nginx 경유) 사용.
# 서브도메인(예: https://api.example.com)으로 백엔드를 따로 둘 때만 채우세요.
PROD_PUBLIC_API_URL=

# Auth / URL (운영에서는 반드시 실제 도메인으로 변경)
# 프론트 주소. CORS 허용 origin, OAuth 로그인 후 리다이렉트 대상으로 쓰입니다.
FRONTEND_URL=http://localhost:3000
# GitHub OAuth App 의 Authorization callback URL 과 같아야 합니다.
#   개발: http://localhost:3001/auth/github/callback
#   운영: https://<도메인>/backend/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false

AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_MODEL=gpt-4.1-mini