# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syncup
DATABASE_URL=postgresql://postgres:postgres@db:5432/syncup

# Backend Configuration
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=log
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=syncup

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_BACKEND_URL=http://backend:3000

AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# 채팅 실시간 번역 (한·영·일, OPENAI_API_KEY 필요)
# CHAT_TRANSLATION_ENABLED=true
# CHAT_TRANSLATION_MAX_CHARS=8000